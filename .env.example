# Copia este archivo a `.env` (NUNCA lo subas a git).
# En el servidor de produccion el `.env` lo crea y mantiene el encargado de infraestructura.

# --- Servidor ---
PORT=3000
# Origenes que pueden llamar al backend desde el navegador (separados por coma).
# En produccion el widget se sirve desde el mismo dominio (https://agichat.jhgo.online).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3230
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000


# --- API keys ---
# OpenAI: https://platform.openai.com/api-keys (puede requerir saldo)
OPENAI_API_KEY=
# Opcionales: modelo y URL base (cualquier proveedor compatible con la API de OpenAI)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# TMDB: https://www.themoviedb.org/settings/api
# (declarar: estudiantes del curso CC3116 de la UVG, uso NO comercial)
TMDB_API_KEY=
# Google Books: Google Cloud Console -> APIs y servicios -> credenciales (sin tarjeta)
GOOGLE_BOOKS_API_KEY=
